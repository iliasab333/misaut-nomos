{
  "name": "Ticket",
  "type": "object",
  "properties": {
    "ticket_number": {
      "type": "string",
      "description": "N\u00famero \u00fanico del ticket (ej: TKT-001234)"
    },
    "title": {
      "type": "string",
      "description": "T\u00edtulo del ticket"
    },
    "description": {
      "type": "string",
      "description": "Descripci\u00f3n detallada del problema"
    },
    "status": {
      "type": "string",
      "enum": [
        "abierto",
        "en_progreso",
        "resuelto",
        "cerrado"
      ],
      "default": "abierto",
      "description": "Estado del ticket"
    },
    "type": {
      "type": "string",
      "enum": [
        "soporte_cliente",
        "soporte_autonomo",
        "reclamo",
        "problema_trabajo",
        "problema_pago",
        "consulta_general"
      ],
      "description": "Tipo de ticket"
    },
    "priority": {
      "type": "string",
      "enum": [
        "baja",
        "media",
        "alta",
        "urgente"
      ],
      "default": "media",
      "description": "Prioridad del ticket"
    },
    "creator_id": {
      "type": "string",
      "description": "ID del usuario que cre\u00f3 el ticket"
    },
    "creator_name": {
      "type": "string",
      "description": "Nombre del creador"
    },
    "creator_type": {
      "type": "string",
      "description": "Tipo de usuario creador (client/professionnel)"
    },
    "assigned_to_id": {
      "type": "string",
      "description": "ID del profesional asignado (si es ticket cliente-aut\u00f3nomo)"
    },
    "assigned_to_name": {
      "type": "string",
      "description": "Nombre del asignado"
    },
    "admin_assigned_id": {
      "type": "string",
      "description": "ID del admin asignado (para moderaci\u00f3n)"
    },
    "admin_assigned_name": {
      "type": "string",
      "description": "Nombre del admin asignado"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "Etiquetas del ticket"
    },
    "attachments": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "URLs de archivos adjuntos"
    },
    "related_conversation_id": {
      "type": "string",
      "description": "ID de conversaci\u00f3n relacionada (si aplica)"
    },
    "related_professional_id": {
      "type": "string",
      "description": "ID del profesional relacionado"
    },
    "last_activity": {
      "type": "string",
      "format": "date-time",
      "description": "\u00daltima actividad en el ticket"
    },
    "resolved_date": {
      "type": "string",
      "format": "date-time",
      "description": "Fecha de resoluci\u00f3n"
    },
    "closed_date": {
      "type": "string",
      "format": "date-time",
      "description": "Fecha de cierre"
    },
    "internal_notes": {
      "type": "string",
      "description": "Notas internas (solo visible para admins)"
    }
  },
  "required": [
    "title",
    "description",
    "type",
    "creator_id"
  ],
  "security": {
    "read": {
      "rule": "resource.creator_id == auth.user_id || resource.assigned_to_id == auth.user_id || auth.role == 'admin'"
    },
    "create": {
      "rule": "authenticated"
    },
    "update": {
      "rule": "resource.creator_id == auth.user_id || resource.assigned_to_id == auth.user_id || auth.role == 'admin'"
    },
    "delete": {
      "rule": "auth.role == 'admin'"
    }
  }
}