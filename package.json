{
  "name": "base44-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run check:i18n && node scripts/i18n-orphans.mjs --strict && node scripts/check-routes.mjs --strict && node scripts/check-vercel-routes.mjs --strict && vite build && npm run prerender && npm run check:sitemap:local",
    "prerender": "node scripts/prerender.mjs",
    "build:nossr": "vite build",
    "check:i18n": "node scripts/check-i18n.mjs",
    "check:routes": "node scripts/check-routes.mjs",
    "check:hooks": "node scripts/check-hook-order.mjs $(find src -name '*.jsx' -o -name '*.js' -o -name '*.tsx')",
    "i18n:inventory": "node scripts/i18n-inventory.mjs",
    "i18n:merge": "node scripts/i18n-merge.mjs",
    "i18n:split": "node scripts/i18n-split.mjs",
    "i18n:orphans": "node scripts/i18n-orphans.mjs",
    "lint": "eslint .",
    "typecheck": "tsc -p ./jsconfig.json",
    "preview": "vite preview",
    "check:sitemap": "node scripts/check-sitemap.mjs",
    "check:sitemap:local": "node scripts/check-sitemap.mjs --generate",
    "predeploy": "npm run build && npm run check:sitemap:local",
    "cap:sync": "vite build && cap sync",
    "cap:ios": "vite build && cap sync ios && cap open ios",
    "cap:android": "vite build && cap sync android && cap open android"
  },
  "dependencies": {
    "@capacitor-community/apple-sign-in": "^7.1.0",
    "@capacitor/android": "^8.4.0",
    "@capacitor/app": "^8.1.0",
    "@capacitor/browser": "^8.0.3",
    "@capacitor/camera": "^8.2.0",
    "@capacitor/core": "^8.4.0",
    "@capacitor/geolocation": "^8.2.0",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.4.0",
    "@capacitor/network": "^8.0.1",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/push-notifications": "^8.1.1",
    "@capacitor/share": "^8.0.1",
    "@capacitor/splash-screen": "^8.0.1",
    "@capacitor/status-bar": "^8.0.2",
    "@fontsource/inter": "^5.2.8",
    "@supabase/supabase-js": "^2.107.0",
    "@tailwindcss/typography": "^0.5.19",
    "@tanstack/react-query": "^5.84.1",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "date-fns": "^3.6.0",
    "framer-motion": "^11.16.4",
    "i18next": "^23.16.8",
    "i18next-browser-languagedetector": "^8.2.1",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.475.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-helmet-async": "^2.0.5",
    "react-i18next": "^14.1.3",
    "react-leaflet": "^4.2.1",
    "react-quill": "^2.0.0",
    "react-router-dom": "^7.2.0",
    "tailwindcss-animate": "^1.0.7"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.4.0",
    "@eslint/js": "^9.19.0",
    "@flydotio/dockerfile": "^0.7.8",
    "@types/node": "^22.13.5",
    "@types/react": "^18.2.66",
    "@types/react-dom": "^18.2.22",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.19.0",
    "eslint-plugin-react": "^7.37.4",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.18",
    "globals": "^15.14.0",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.9.3",
    "vite": "^6.1.0"
  }
}
